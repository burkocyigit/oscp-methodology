{
	"nodes":[
		{"id":"start","type":"text","text":"BASLA\nIP, scope ve not alma hazirla","x":-1520,"y":0,"width":260,"height":110},
		{"id":"tcp","type":"text","text":"TCP/UDP kesif\nTum TCP portlari + gerekli UDP\nVersiyon, banner ve script taramasi\nHostname'leri /etc/hosts'a ekle","x":-1160,"y":-20,"width":300,"height":150},
		{"id":"services","type":"text","text":"Acik servisleri dallandir\nWeb | SMB | FTP | DB | DNS/RPC/NFS | Mail\nHer bulguyu loot olarak kaydet","x":-560,"y":-320,"width":280,"height":170},
		{"id":"webvuln","type":"text","text":"Web karari\nCMS mi? WordPress/Joomla/Drupal enum\nXSS disinda giris: SQLi, LFI/RFI, SSTI, XXE, SSRF\nUpload/command injection/deserialization/IDOR\nXAMPP: phpMyAdmin, default DB, FILE, OUTFILE","x":615,"y":-420,"width":300,"height":190},
		{"id":"web","type":"text","text":"WEB\nFingerprint: headers, source, cookies, whatweb\nFuzz: dir/file/ext/param/vhost\n.git, backup, config, upload, admin bulundu mu?\nBuldugunu indir ve incele","x":115,"y":-1080,"width":380,"height":210},
		{"id":"webnote","type":"file","file":"Enumeration/Web Application.md","x":-280,"y":-2080,"width":1005,"height":680},
		{"id":"ports","type":"file","file":"Enumeration/Port Scanning.md","x":-1750,"y":500,"width":590,"height":500},
		{"id":"creds0","type":"text","text":"Credential veya kod calistirma bulundu mu?\nCredential: tum servislerde yeniden dene\nCode execution: listener ac, shell al\nYoksa diger servis dallarina ve exact exploit aramasina don","x":915,"y":80,"width":365,"height":160},
		{"id":"linuxpriv","type":"text","text":"Linux karari\nsudo komutu exploitable mi? GTFOBins\nSUID/capability/cron/service writable mi?\nSSH key veya reused password var mi?\nRoot shell al, sonra hash/loot topla","x":2645,"y":575,"width":280,"height":140},
		{"id":"adnote","type":"file","file":"Active Directory/Active Directory Methodology.md","x":3213,"y":-1040,"width":685,"height":520},
		{"id":"pivot","type":"text","text":"PIVOT / LATERAL\nSMB, WinRM, PsExec, WMI, RDP, MSSQL\nLigolo-ng, Chisel veya SSH port forward\nYeni subnet'i tekrar tara\nYeni hostta loot + privesc dongusunu baslat","x":3705,"y":1435,"width":300,"height":160},
		{"id":"pivotnote","type":"file","file":"Lateral Movement/Pivoting & Port Forwarding.md","x":3715,"y":1880,"width":540,"height":680},
		{"id":"windowsnote","type":"file","file":"Privilege Escalation/Windows Privilege Escalation.md","x":2620,"y":1800,"width":775,"height":760},
		{"id":"winpriv","type":"text","text":"Windows karari\nSeImpersonate -> PrintSpoofer/GodPotato/JuicyPotato\nSeBackup -> shadow copy + SAM/SYSTEM/NTDS\nSeDebug -> LSASS; Restore/TakeOwnership -> servis/dosya\nYoksa weak service, task, unattended, hijack kontrol et","x":2760,"y":1425,"width":280,"height":170},
		{"id":"hashes","type":"text","text":"ADMIN / ROOT / HASH\nSAM/LSA/LSASS veya NTDS parse et\nSeBackup ile NTDS.dit + SYSTEM al\nHash'leri crack et veya pass-the-hash\nDomain hash'i varsa AD kararina gec","x":3600,"y":953,"width":320,"height":185},
		{"id":"localos","type":"text","text":"LOCAL PRIVESC\nLinux: sudo -l -> SUID/SGID -> capabilities -> cron/PATH/wildcard -> writable config/service -> NFS -> container\nWindows: whoami /priv -> service/task -> AlwaysInstallElevated -> creds -> DLL/PATH\nOtomasyonla bul, manuel dogrula; kernel en son","x":2595,"y":1046,"width":380,"height":220},
		{"id":"roast","type":"text","text":"ROAST\nUsername var, credential yok -> AS-REP roast\nSPN var -> Kerberoast\nHash crack -> loot loop ve tum servislere credential reuse","x":2850,"y":-380,"width":363,"height":140},
		{"id":"acl","type":"text","text":"BloodHound edge bulundu mu?\nGenericAll/GenericWrite/WriteDACL/WriteOwner\nForceChangePassword/Group membership\nReadGMSAPassword\nEdge'i abuse et, yeni credential al, graph'i yeniden hesapla","x":4625,"y":-185,"width":495,"height":145},
		{"id":"delegnote","type":"file","file":"Active Directory/Delegation Abuse.md","x":5200,"y":733,"width":785,"height":625},
		{"id":"linuxnote","type":"file","file":"Privilege Escalation/Linux Privilege Escalation.md","x":1098,"y":829,"width":795,"height":874},
		{"id":"reuse","type":"text","text":"Yeniden kullanim\nSSH/SMB/WinRM/RDP/DB ve diger hostlarda dene\nNTLM hash varsa pass-the-hash\nYeni shell varsa loot loop'a don","x":2220,"y":-645,"width":380,"height":165},
		{"id":"spray","type":"text","text":"Domain kullanicilari mi var?\nUsername listesi temizle\nLockout policy kontrol et\nTek aday parola ile spray et\nBasarili host/account ciftlerini kaydet","x":3095,"y":395,"width":300,"height":150},
		{"id":"adenum","type":"text","text":"AD ENUM\nNull SMB/RPC, LDAP anonymous bind\nKerberos username enum, DNS AXFR\nGecerli user varsa BloodHound/RustHound\nLDAP, users/groups, share ve description tara","x":3685,"y":-380,"width":395,"height":140},
		{"id":"deleg","type":"text","text":"Delegation var mi?\nUnconstrained: host + privileged auth coercion + TGT\nConstrained: S4U ile izinli SPN\nRBCD: MAQ/SPN + RBCD write + S4U\nHer adimdan sonra yeni path ara","x":4625,"y":150,"width":335,"height":210},
		{"id":"adq","type":"text","text":"AD / DOMAIN sinyali var mi?\nDNS/LDAP/Kerberos/SMB domain verisi\nYoksa standalone bitis kontrolune gec\nVarsa anonim enum veya gecerli user ile devam","x":3715,"y":395,"width":290,"height":206},
		{"id":"loot","type":"text","text":"CREDENTIAL / LOOT LOOP\nLinux: history, SSH keys, configs, .env/.git, DB, /proc, cron, KeePass/browser\nWindows: PowerShell history, Unattend, web.config, XAMPP, RDP/PuTTY, cmdkey, registry\nYeni password/hash/key bulundu mu?","x":1988,"y":365,"width":465,"height":200},
		{"id":"shell","type":"text","text":"FOOTHOLD\nLinux PTY veya Windows PowerShell/WinRM stabilize et\nTool transfer: HTTP, SMB, wget/curl, PowerShell, certutil\nHemen: user, hostname, OS, groups, arch, interfaces, routes, listening services","x":1400,"y":435,"width":353,"height":210},
		{"id":"version","type":"text","text":"Kesin urun ve versiyon var mi?\nExact version CVE/exploit ara\nOnce dogrula, sonra exploit et","x":-840,"y":880,"width":280,"height":89},
		{"id":"dns","type":"text","text":"DNS / hostname bulundu mu?\nAXFR, A/MX/NS/TXT/SRV/reverse\nHer hostname'i tekrar tara","x":-520,"y":70,"width":280,"height":120},
		{"id":"other","type":"text","text":"DIGER SERVISLER\nFTP: anonymous read/write, webroot overlap\nDB: default creds; MSSQL xp_cmdshell; MySQL FILE; PostgreSQL COPY PROGRAM\nRPC/NFS: exports, no_root_squash, writable mount\nMail: SMTP users, POP3/IMAP mail ve reset linkleri","x":0,"y":589,"width":380,"height":240},
		{"id":"smbnote","type":"file","file":"Enumeration/SMB Enumeration.md","x":45,"y":-725,"width":450,"height":495},
		{"id":"finish","type":"text","text":"STANDALONE TAMAMLAMA\nRoot/SYSTEM ve proof al\nKomut, path, hash, hesap ve kanitlari kaydet\nPersistence sadece istenirse\nSSH authorized_keys veya local admin\nRaporlanabilir temiz akisa don","x":4775,"y":640,"width":335,"height":239},
		{"id":"pivotq","type":"text","text":"Baska host/subnet veya internal-only servis var mi?\nInterface ve route kontrol et\nYoksa standalone completion'a gec","x":4400,"y":1358,"width":300,"height":150},
		{"id":"smb","type":"text","text":"SMB 139/445\nNull/Guest erisimi dene\nShare'leri recursive indir\nSYSVOL, NETLOGON, Backup, IT, Scripts, Users\nGroups.xml/cpassword, hive, backup ara","x":190,"y":50,"width":375,"height":220}
	],
